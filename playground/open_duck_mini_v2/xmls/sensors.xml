    <actuatorfrc name="head_pitch_force" actuator="head_pitch"/>
    <actuatorfrc name="head_yaw_force" actuator="head_yaw"/>
    <actuatorfrc name="head_roll_force" actuator="head_roll"/>
    <actuatorfrc name="right_hip_yaw_force" actuator="right_hip_yaw"/>
    <actuatorfrc name="right_hip_roll_force" actuator="right_hip_roll"/>
    <actuatorfrc name="right_hip_pitch_force" actuator="right_hip_pitch"/>
    <actuatorfrc name="right_knee_force" actuator="right_knee"/>
    <actuatorfrc name="right_ankle_force" actuator="right_ankle"/>
